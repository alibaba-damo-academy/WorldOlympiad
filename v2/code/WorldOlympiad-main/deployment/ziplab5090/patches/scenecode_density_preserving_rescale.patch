 def _scale_inertial(inertial: ET.Element, scale_factor: float) -> None:
-    """Scale inertial properties: CoM pose and inertia tensor."""
+    """Scale inertial properties: mass, CoM pose and inertia tensor.
+
+    A uniform geometric rescale preserves the material density, so the mass
+    scales as ``s^3`` and the inertia tensor (mass times distance squared) as
+    ``s^5``.  Scaling only the tensor while keeping the mass fixed leaves the
+    resized asset with an unphysical density: a normalized 1 m object later
+    placed at a few centimetres keeps a metre-scale mass and becomes
+    ungraspable by the task robots.
+    """
+    mass_node = inertial.find("mass")
+    if mass_node is not None and mass_node.text and mass_node.text.strip():
+        mass = float(mass_node.text)
+        mass_node.text = f"{mass * scale_factor ** 3:.12g}"
+
     # Scale center of mass pose translation.
     inertial_pose = inertial.find("pose")
     if inertial_pose is not None and inertial_pose.text:
@@ -334,7 +347,8 @@
