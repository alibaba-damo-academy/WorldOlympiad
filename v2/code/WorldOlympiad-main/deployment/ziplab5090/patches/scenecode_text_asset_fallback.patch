+    def generate_from_text(
+        self,
+        *,
+        text_input: str,
+        output_dir: Path,
+        config_path_override: str | Path | None = None,
+    ) -> CodeObjectGenerationResult:
+        """Run the vendored Code_Object text-conditioned pipeline.
+
+        SceneCode normally synthesizes a reference image first, although the
+        vendored pipeline natively accepts text. This entry point preserves the
+        same retry/resume contract when a compatible deployment does not offer
+        an image-generation model.
+        """
+        if not text_input.strip():
+            raise ValueError("Code_Object text input must be non-empty")
+
+        output_dir.mkdir(parents=True, exist_ok=True)
+        active_config_path = (
+            self._resolve_config_path(str(config_path_override))
+            if config_path_override is not None
+            else self._config_path
+        )
+        port = self._reserve_port()
+        attempt_summaries: list[str] = []
+        try:
+            pipeline_cls = self._load_pipeline_class()
+            for attempt in range(1, self._max_attempts + 1):
+                resume_state = self._detect_resume_state(output_dir)
+                console_logger.info(
+                    "Code_Object text attempt %d/%d for %r "
+                    "(has_existing_plan=%s, has_existing_parts=%s, skip_stages=%s)",
+                    attempt,
+                    self._max_attempts,
+                    text_input,
+                    resume_state.has_existing_plan,
+                    resume_state.has_existing_parts,
+                    list(resume_state.skip_stages),
+                )
+                pipeline = pipeline_cls(
+                    config_path=str(active_config_path), use_mock=False, port=port
+                )
+                result = asyncio.run(
+                    pipeline.run(
+                        text_input=text_input,
+                        output_dir=str(output_dir),
+                        skip_stages=list(resume_state.skip_stages),
+                    )
+                )
+                if getattr(result, "success", False):
+                    mesh_path = self._resolve_mesh_path(
+                        result=result, output_dir=output_dir
+                    )
+                    if mesh_path is not None and mesh_path.exists():
+                        return self._build_generation_result(
+                            output_dir=output_dir, mesh_path=mesh_path
+                        )
+                    failure_summary = (
+                        "pipeline reported success but did not produce a GLB export"
+                    )
+                else:
+                    failure_summary = self._summarize_pipeline_failure(result)
+                attempt_summaries.append(
+                    f"attempt {attempt}/{self._max_attempts}: {failure_summary}"
+                )
+                console_logger.warning(
+                    "Code_Object text attempt %d/%d failed for %r: %s",
+                    attempt,
+                    self._max_attempts,
+                    text_input,
+                    failure_summary,
+                )
+        finally:
+            self._release_port(port)
+
+        raise RuntimeError(
+            f"Code_Object text pipeline failed after {self._max_attempts} "
+            f"attempt(s): {'; '.join(attempt_summaries)}"
         )
 
+    def generate_articulated_from_text(
+        self,
