+    async def _disconnect_llm_clients(self) -> None:
+        """Close each distinct provider client before its event loop exits."""
+        seen: set[int] = set()
+        for client in (
+            self.llm_client,
+            self.planner_llm_client,
+            self.constructor_llm_client,
+        ):
+            if client is None or id(client) in seen:
+                continue
+            seen.add(id(client))
+            try:
+                await client.close()
+            except Exception as exc:
+                self.logger.warning("Failed to close LLM client: %s", exc)
+        self.llm_client = None
