+def _load_sdf_visual_link_meshes(sdf_path: Path):
+    """Read declared glTF visuals in model coordinates, including SDF FK/scale."""
+    from pydrake.all import AddMultibodyPlantSceneGraph, DiagramBuilder, Mesh, Parser
+
+    builder = DiagramBuilder()
+    plant, scene_graph = AddMultibodyPlantSceneGraph(builder, time_step=0.001)
+    model = Parser(plant).AddModels(str(sdf_path.resolve()))[0]
+    plant.Finalize()
+    context = plant.CreateDefaultContext()
+    model_frame = plant.GetFrameByName("__model__", model)
+    inspector = scene_graph.model_inspector()
+    meshes = []
+    for body_index in plant.GetBodyIndices(model):
+        body = plant.get_body(body_index)
+        X_MB = plant.CalcRelativeTransform(context, model_frame, body.body_frame())
+        for geometry in plant.GetVisualGeometriesForBody(body):
+            shape = inspector.GetShape(geometry)
+            if not isinstance(shape, Mesh):
+                continue
+            mesh_path = Path(shape.source().path())
+            if mesh_path.suffix.lower() not in {".gltf", ".glb"}:
+                continue
+            mesh = _load_and_prepare_mesh(mesh_path)
+            mesh.apply_scale(shape.scale())
+            mesh.apply_transform((X_MB @ inspector.GetPoseInFrame(geometry)).GetAsMatrix4())
+            meshes.append((mesh_path, body.name(), mesh))
+    return meshes
+
