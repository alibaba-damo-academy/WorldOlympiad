 console_logger = logging.getLogger(__name__)
 
+TASK_MARKER_COLORS = {
+    "red": (190, 45, 45),
+    "green": (45, 165, 75),
+    "blue": (45, 90, 190),
+    "yellow": (220, 185, 45),
+    "orange": (220, 115, 35),
+    "purple": (135, 70, 175),
+    "brown": (125, 80, 45),
+    "gray": (125, 125, 125),
+    "grey": (125, 125, 125),
+    "black": (30, 30, 30),
+    "white": (225, 225, 225),
+}
+TASK_MARKER_TOKENS = {"goal", "marker", "pad", "target", "zone"}
 
+
+def _solid_task_marker_color(description: str) -> tuple[str, tuple[int, int, int]] | None:
+    """Return an explicit basic color only for a semantic task-region marker."""
+
+    lowered = description.lower()
+    if not any(re.search(rf"\b{token}\b", lowered) for token in TASK_MARKER_TOKENS):
+        return None
+    candidates = []
+    for name, rgb in TASK_MARKER_COLORS.items():
+        match = re.search(rf"\b{name}\b", lowered)
+        if match is not None:
+            candidates.append((match.start(), name, rgb))
+    if not candidates:
+        return None
+    _, name, rgb = min(candidates)
+    return name, rgb
+
