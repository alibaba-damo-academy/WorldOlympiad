     visual_dir = sdf_dir / "visual"
 
-    if not visual_dir.exists():
+    if not visual_dir.exists() or not any(visual_dir.glob("*.gltf")):
+        if (sdf_dir / "blender_output" / "parts").is_dir():
+            from scenecode.agent_utils.support_surface_extraction import _load_sdf_visual_link_meshes
+
+            # CodeObject SDF visuals provide measured model-frame bounds.
+            # Their declared scale is already applied by the shared loader.
+            meshes = _load_sdf_visual_link_meshes(sdf_path)
+            if not meshes:
+                raise ValueError(f"CodeObject SDF has no usable visual meshes: {sdf_path}")
+            minimum = np.min([mesh.bounds[0] for _, _, mesh in meshes], axis=0)
+            maximum = np.max([mesh.bounds[1] for _, _, mesh in meshes], axis=0)
+            return minimum, maximum, (minimum + maximum) / 2
         console_logger.warning(f"Visual directory not found: {visual_dir}")
