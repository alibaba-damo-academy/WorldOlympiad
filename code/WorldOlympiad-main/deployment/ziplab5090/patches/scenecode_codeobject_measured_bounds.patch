--- a/scenecode/agent_utils/room.py
+++ b/scenecode/agent_utils/room.py
@@ -503,6 +503,23 @@
 
     scale_factor: float = 1.0
     """Cumulative scale factor applied to this object's asset (1.0 = original size)."""
+
+    def __post_init__(self) -> None:
+        if (self.metadata.get("asset_source") != "code_articulated"
+                or self.sdf_path is None or not self.sdf_path.is_file()):
+            return
+        if (self.bbox_min is not None and self.bbox_max is not None
+                and np.all(np.isfinite([self.bbox_min, self.bbox_max]))
+                and np.all(np.asarray(self.bbox_max) > np.asarray(self.bbox_min))):
+            return
+        from scenecode.agent_utils.urdf_to_sdf import compute_sdf_bounding_box
+
+        lo, hi, _ = compute_sdf_bounding_box(self.sdf_path)
+        if not np.all(np.isfinite([lo, hi])) or not np.all(hi > lo):
+            raise ValueError(f"Articulated asset has no measured 3D bounds: {self.sdf_path}")
+        self.bbox_min, self.bbox_max = lo, hi
+        console_logger.info("Recomputed invalid CodeObject bounds from %s: %s -> %s",
+                            self.sdf_path, lo, hi)
 
